DATABASE_URL=

# ── Tampa Construction Feeds ──────────────────────────────────────────────
#
# City of Tampa building permits (Socrata)
#   1. Go to https://data.tampagov.net
#   2. Search "Building Permits" and open the dataset
#   3. Click "API" tab — copy the ID from the path: /resource/<ID>.json
TAMPA_SOCRATA_BASE=https://data.tampagov.net
TAMPA_PERMITS_DATASET_ID=

# Hillsborough County permits (Socrata)
#   1. Go to https://opendata.hillsboroughcounty.org
#   2. Search "Building Permits" and open the dataset
#   3. Click "API" tab — copy the dataset ID
HILLSBOROUGH_SOCRATA_BASE=https://opendata.hillsboroughcounty.org
HILLSBOROUGH_PERMITS_DATASET_ID=

# Optional: Socrata app token (removes 1,000 req/hr rate limit)
#   Register free at https://data.tampagov.net/profile/app_tokens
SOCRATA_APP_TOKEN=

# Construction feed filters
CONSTRUCTION_MIN_JOB_VALUE=100000
CONSTRUCTION_FETCH_LIMIT=200
CONSTRUCTION_LOOKBACK_DAYS=90
